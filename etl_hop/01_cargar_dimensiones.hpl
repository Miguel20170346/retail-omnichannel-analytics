  <transform>
    <type>TableInput</type>
    <name>Extraer Promociones Oracle</name>
    <sql>SELECT
    CAST(0 AS NUMBER(10))                  AS SK_PROMOCION,
    CAST(0 AS NUMBER(10))                  AS ID_PROMOCION_OLTP,
    CAST('SIN PROMOCION' AS VARCHAR2(50))  AS TIPO,
    CAST(0 AS NUMBER(10,2))                AS VALOR,
    CAST('Sin promocion' AS VARCHAR2(500)) AS DESCRIPCION,
    CAST(NULL AS DATE)                     AS FECHA_INICIO,
    CAST(NULL AS DATE)                     AS FECHA_FIN
FROM DUAL
UNION ALL
SELECT
    CAST(ROW_NUMBER() OVER (ORDER BY ID_PROMOCION) AS NUMBER(10)) AS SK_PROMOCION,
    CAST(ID_PROMOCION AS NUMBER(10)) AS ID_PROMOCION_OLTP,
    TIPO,
    VALOR,
    DESCRIPCION,
    FECHA_INICIO,
    FECHA_FIN
FROM TRX_PROMOCIONES</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Oracle_OLTP</connection>
