  <transform>
    <type>TableInput</type>
    <name>Extraer Fechas Oracle</name>
    <sql>SELECT
    CAST(TO_NUMBER(TO_CHAR(f, 'YYYYMMDD')) AS NUMBER(8)) AS SK_FECHA,
    f                                                    AS FECHA,
    CAST(EXTRACT(YEAR FROM f) AS NUMBER(4))              AS ANIO,
    CAST(TO_NUMBER(TO_CHAR(f, 'Q')) AS NUMBER(1))        AS TRIMESTRE,
    CAST(EXTRACT(MONTH FROM f) AS NUMBER(2))             AS MES,
    CAST(DECODE(EXTRACT(MONTH FROM f),
         1,'Enero',2,'Febrero',3,'Marzo',4,'Abril',5,'Mayo',6,'Junio',
         7,'Julio',8,'Agosto',9,'Septiembre',10,'Octubre',11,'Noviembre','Diciembre')
         AS VARCHAR2(20))                                AS NOMBRE_MES,
    CAST(EXTRACT(DAY FROM f) AS NUMBER(2))               AS DIA,
    CAST(TRUNC(f) - TRUNC(f, 'IW') + 1 AS NUMBER(1))     AS DIA_SEMANA,
    CAST(DECODE(TRUNC(f) - TRUNC(f, 'IW') + 1,
         1,'Lunes',2,'Martes',3,'Miercoles',4,'Jueves',
         5,'Viernes',6,'Sabado','Domingo')
         AS VARCHAR2(20))                                AS NOMBRE_DIA,
    CAST(TO_NUMBER(TO_CHAR(f, 'IW')) AS NUMBER(2))       AS SEMANA_ANIO,
    CAST(CASE WHEN TRUNC(f) - TRUNC(f, 'IW') + 1 >= 6 THEN 'S' ELSE 'N' END
         AS CHAR(1))                                     AS ES_FIN_SEMANA
FROM (
    SELECT DATE '2025-01-01' + LEVEL - 1 AS f
    FROM DUAL
    CONNECT BY LEVEL &lt;= DATE '2027-12-31' - DATE '2025-01-01' + 1
)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Oracle_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>784</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
