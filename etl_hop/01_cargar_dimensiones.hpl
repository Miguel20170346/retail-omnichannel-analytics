  <transform>
    <type>TableInput</type>
    <name>Extraer Empleados Oracle  </name>
    <sql>SELECT
    e.ID_EMPLEADO         AS ID_EMPLEADO_OLTP,
    e.NOMBRE              AS NOMBRE,
    e.CARGO               AS CARGO,
    s.CODIGO_SUCURSAL     AS CODIGO_SUCURSAL,
    s.NOMBRE_SUCURSAL     AS SUCURSAL,
    d.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_SUCURSAL,
    p.NOMBRE_PAIS         AS PAIS_SUCURSAL
FROM TRX_EMPLEADOS e
JOIN TRX_SUCURSALES s    ON s.ID_SUCURSAL = e.ID_SUCURSAL
JOIN TRX_DEPARTAMENTOS d ON d.ID_DEPARTAMENTO = s.ID_DEPARTAMENTO
JOIN TRX_PAISES p        ON p.ID_PAIS = d.ID_PAIS
ORDER BY e.ID_EMPLEADO</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Oracle_OLTP</connection>
