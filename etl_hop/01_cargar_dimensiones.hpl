  <transform>
    <type>TableInput</type>
    <name>Extraer Clientes Oracle</name>
    <sql>SELECT
    c.ID_CLIENTE          AS ID_CLIENTE_OLTP,
    c.NOMBRE              AS NOMBRE,
    c.EMAIL               AS EMAIL,
    c.SEGMENTO            AS SEGMENTO,
    pa.NOMBRE_PAIS        AS PAIS,
    pa.CODIGO_PAIS        AS CODIGO_PAIS,
    d.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO,
    z.NOMBRE_ZONA         AS ZONA,
    c.FECHA_REGISTRO      AS FECHA_REGISTRO
FROM TRX_CLIENTES c
JOIN TRX_PAISES pa       ON pa.ID_PAIS = c.ID_PAIS
JOIN TRX_DEPARTAMENTOS d ON d.ID_DEPARTAMENTO = c.ID_DEPARTAMENTO
JOIN TRX_ZONAS z         ON z.ID_ZONA = c.ID_ZONA
ORDER BY c.ID_CLIENTE</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Oracle_OLTP</connection>
