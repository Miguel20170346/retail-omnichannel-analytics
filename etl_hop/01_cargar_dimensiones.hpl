  <transform>
    <type>TableInput</type>
    <name>Extraer Productos Oracle</name>
    <sql>SELECT
    p.ID_PRODUCTO        AS ID_PRODUCTO_OLTP,
    p.NOMBRE_PRODUCTO    AS NOMBRE_PRODUCTO,
    c.NOMBRE_CATEGORIA   AS CATEGORIA,
    NVL(cp.NOMBRE_CATEGORIA, c.NOMBRE_CATEGORIA) AS CATEGORIA_PADRE,
    m.NOMBRE_MARCA       AS MARCA,
    pr.NOMBRE_PROVEEDOR  AS PROVEEDOR,
    p.PRECIO_BASE        AS PRECIO_BASE_USD,
    p.COSTO_UNITARIO_USD AS COSTO_UNITARIO_USD
FROM TRX_PRODUCTOS p
JOIN TRX_CATEGORIAS_PRODUCTO c       ON c.ID_CATEGORIA = p.ID_CATEGORIA
LEFT JOIN TRX_CATEGORIAS_PRODUCTO cp ON cp.ID_CATEGORIA = c.ID_CATEGORIA_PADRE
JOIN TRX_MARCAS m                    ON m.ID_MARCA = p.ID_MARCA
JOIN TRX_PROVEEDORES pr              ON pr.ID_PROVEEDOR = p.ID_PROVEEDOR
ORDER BY p.ID_PRODUCTO</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Oracle_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
